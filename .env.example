# ===================================================
# Power of Media - Multi-Tenant WhatsApp SaaS Backend
# Environment Configuration
# ===================================================

# Server Port
PORT=3000
NODE_ENV=development

# Central Webhook Verify Token (configured in Meta Developer App)
META_VERIFY_TOKEN=power_of_media_verify_token_2026

# Meta Graph API Version
META_GRAPH_API_VERSION=v21.0

# Supabase Configuration (PostgreSQL Database)
# Leave blank to run in Local In-Memory / File Fallback Mode for testing
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional: Admin Secret Key for API Security (Header: x-api-key)
ADMIN_API_KEY=pom_admin_secret_key_change_me
